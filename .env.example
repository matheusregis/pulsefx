# Copy to .env and fill in. Used both by `docker compose` and by the API
# running directly on the host (`npm run dev:api`).

# --- Postgres ---
POSTGRES_USER=pulsefx
POSTGRES_PASSWORD=pulsefx
POSTGRES_DB=pulsefx
# From the host (npm run dev:api / prisma migrate dev): localhost:5433
#   (5433, not 5432, to dodge a locally-running Postgres — see docker-compose.yml)
# From inside docker compose (API container): postgres:5432 (overridden in docker-compose.yml)
DATABASE_URL=postgresql://pulsefx:pulsefx@localhost:5433/pulsefx?schema=public

# --- API ---
PORT=4000
NODE_ENV=development
# Required. Free key: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=replace-with-your-fred-api-key
# Required, min 8 chars. Sent as `X-Admin-Token` to POST /api/admin/sync.
ADMIN_SYNC_TOKEN=replace-with-a-long-random-string
# How often the background sync job refreshes observations from BCB/FRED.
SYNC_INTERVAL_MINUTES=180
# Origin allowed to call the API (the web app's dev/served URL).
CORS_ORIGIN=http://localhost:5173

# --- Web ---
VITE_API_URL=http://localhost:4000
